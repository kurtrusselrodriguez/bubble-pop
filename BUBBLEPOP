def accounts():
    local = {}
    try:
        loaded = json.loads(DATA.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        loaded = {}
    if isinstance(loaded, dict):
        local = loaded
    connection = mysql_connection()
    if connection is None:
        return local
    try:
        cursor = connection.cursor(dictionary=True)
        cursor.execute("SELECT username, salt, password_hash, best FROM players")
        rows: Any = cursor.fetchall()
        for row in rows:
            local[row["username"]] = {"salt": row["salt"], "password": row["password_hash"], "best": row["best"]}
        cursor.close()
    except Exception:
        pass
    finally:
        connection.close()
    return local


def save(data):
    saved = True
    try:
        DATA.write_text(json.dumps(data, indent=2), encoding="utf-8")
    except (OSError, TypeError, ValueError):
        saved = False
    connection = mysql_connection()
    if connection is not None:
        try:
            cursor = connection.cursor()
            for username, account in data.items():
                cursor.execute(
                    "INSERT INTO players (username, salt, password_hash, best) VALUES (%s, %s, %s, %s) "
                    "ON DUPLICATE KEY UPDATE salt=VALUES(salt), password_hash=VALUES(password_hash), best=VALUES(best)",
                    (username, account.get("salt", ""), account.get("password", ""), best_score(account)),
                )
            connection.commit()
            cursor.close()
        except Exception:
            saved = False
        finally:
            connection.close()
    return saved


def mysql_connection():
    if mysql is None or os.getenv("BUBBLEPOP_DB_DISABLED", "").lower() in {"1", "true", "yes"}:
        return None
    try:
        config = {
            "host": os.getenv("BUBBLEPOP_DB_HOST", "127.0.0.1"),
            "port": int(os.getenv("BUBBLEPOP_DB_PORT", "3306")),
            "user": os.getenv("BUBBLEPOP_DB_USER", "root"),
            "password": os.getenv("BUBBLEPOP_DB_PASSWORD", ""),
            "connection_timeout": int(os.getenv("BUBBLEPOP_DB_TIMEOUT", "2")),
            "use_pure": True,
        }
        connection = mysql.connector.connect(**config)
        cursor = connection.cursor()
        cursor.execute(f"CREATE DATABASE IF NOT EXISTS `{MYSQL_DATABASE}`")
        cursor.close()
        connection.close()
        config["database"] = MYSQL_DATABASE
        connection = mysql.connector.connect(**config)
        cursor = connection.cursor()
        cursor.execute(
            "CREATE TABLE IF NOT EXISTS players ("
            "username VARCHAR(28) PRIMARY KEY, salt VARCHAR(64) NOT NULL, "
            "password_hash CHAR(64) NOT NULL, best INT UNSIGNED NOT NULL DEFAULT 0, "
            "updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP)"
        )
        connection.commit()
        cursor.close()
        return connection
    except Exception:
        return None


def best_score(account):
    try:
        return max(0, int(account.get("best", 0))) if isinstance(account, dict) else 0
    except (TypeError, ValueError):
        return 0


def hash_password(value, salt=None):
    salt = salt or secrets.token_hex(16)
    return salt, hashlib.pbkdf2_hmac("sha256", value.encode(), salt.encode(), 120000).hex()


def valid_password(value, account):
    if not isinstance(account, dict):
        return False
    salt, expected = account.get("salt"), account.get("password")
    if not isinstance(salt, str) or not isinstance(expected, str):
        return False
    _, digest = hash_password(value, salt)
    return secrets.compare_digest(digest, expected)


def ensure_hand_model():
    try:
        if HAND_MODEL.exists() and HAND_MODEL.stat().st_size > 0:
            return HAND_MODEL
    except OSError:
        return None
    temporary = HAND_MODEL.with_suffix(".download")
    try:
        urllib.request.urlretrieve(HAND_MODEL_URL, temporary)
        temporary.replace(HAND_MODEL)
    except (OSError, urllib.error.URLError):
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass
        return None
    return HAND_MODEL


