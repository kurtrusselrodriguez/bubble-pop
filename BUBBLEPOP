    if paused: box(frame,(385,275),(715,450),(14,25,34)); txt(frame,"PAUSED",(475,350),1.15,YELLOW,3); txt(frame,"Press P to resume",(450,405),.58,WHITE,1)


def main():
    data=accounts(); state="login"; registering=False; field="user"; user=""; password=""; notice=""; current=""
    camera=open_camera(); camera_retry_at=time.monotonic()+2; hands=Hand(); x,y=W/2,H/2+20; mouse_x,mouse_y=x,y; health=5; distance=0.; started=0.; last=time.monotonic(); paused=False; pause_started=0.; paused_total=0.; shield=slow=0.; traps=[]; result=(0,0,0,0)
    def reset():
        nonlocal x,y,health,distance,started,last,paused,pause_started,paused_total,shield,slow,traps
        x,y=W/2,H/2+20; health=5; distance=0.; started=last=time.monotonic(); paused=False; pause_started=0.; paused_total=0.; shield=slow=0.; traps=[Trap() for _ in range(8)]
    def keypress(key):
        nonlocal state,registering,field,user,password,notice,current,paused,pause_started,paused_total
        if key in (ord('q'),ord('Q'),27): state="quit"; return
        if state=="login":
            if key==9: field="pass" if field=="user" else "user"
            elif key==8:
                if field=="user": user=user[:-1]
                else: password=password[:-1]
            elif key in (10,13):
                if not user or not password: notice="ENTER A USERNAME AND PASSWORD"
                elif registering:
                    if user in data: notice="ACCOUNT ALREADY EXISTS"
                    else:
                        salt,digest=hash_password(password); data[user]={"salt":salt,"password":digest,"best":0}; save(data); current=user; state="menu"; notice=""
                elif user not in data or not valid_password(password,data[user]): notice="LOGIN FAILED - CHECK DETAILS"
                else: current=user; state="menu"; notice=""
            elif 32<=key<=126 and len(user if field=="user" else password)<28:
                if field=="user": user+=chr(key).lower()
                else: password+=chr(key)
        elif state=="menu":
            if key in (ord('s'),ord('S')): reset(); state="game"
            elif key in (ord('i'),ord('I')): state="instructions"
            elif key in (ord('l'),ord('L')): user=password=""; state="login"
        elif state=="instructions" and key in (ord('m'),ord('M')): state="menu"
        elif state=="game" and key in (ord('p'),ord('P')):
            if paused:
                paused_total += time.monotonic() - pause_started
                paused = False
            else:
                pause_started = time.monotonic()
                paused = True
        elif state=="results":
            if key in (10,13): reset(); state="game"
            elif key in (ord('m'),ord('M')): state="menu"

    def mouse(event, mx, my, _flags, _userdata):
        nonlocal field, registering, mouse_x, mouse_y
        if event in (cv2.EVENT_MOUSEMOVE, cv2.EVENT_LBUTTONDOWN):
            mouse_x, mouse_y = mx, my
        if event != cv2.EVENT_LBUTTONDOWN:
            return
        if state == "login":
            if 325 <= mx <= 775 and 330 <= my <= 382:
                field = "user"
            elif 325 <= mx <= 775 and 430 <= my <= 482:
                field = "pass"
            elif 425 <= mx <= 675 and 500 <= my <= 555:
                keypress(13)
            elif 425 <= mx <= 675 and 575 <= my <= 625:
                registering = not registering
                notice = ""
        elif state == "menu":
            if 350 <= mx <= 750 and 295 <= my <= 355:
                keypress(ord("s"))
            elif 350 <= mx <= 750 and 385 <= my <= 445:
                keypress(ord("i"))

    cv2.namedWindow(WIN,cv2.WINDOW_NORMAL); cv2.resizeWindow(WIN,W,H)
    cv2.setMouseCallback(WIN, mouse)
    try:
        while state!="quit":
            now=time.monotonic(); frame,camera_ok=camera_frame(camera,int(now*30))
            if not camera_ok and now>=camera_retry_at:
                camera.release()
                camera=open_camera()
                camera_retry_at=now+2
            if state=="login": login(frame,user,password,registering,field,notice)
            elif state=="menu": menu(frame,current,data)
            elif state=="instructions": instructions(frame)
            elif state=="results": results(frame,current,*result)
            elif state=="game":
                elapsed=(pause_started if paused else now)-started-paused_total; dt=min(now-last,.08)
                if not paused:
                    xr,yr,gesture=hands.read(frame)
                    if not camera_ok or gesture == "MOUSE FALLBACK":
                        xr, yr = mouse_x / W, mouse_y / H
                    x+=(xr*W-x)*min(1,dt*4.4); y+=(yr*H-y)*min(1,dt*4.4); x=max(80,min(W-80,x)); y=max(125,min(H-150,y))
                    if "OPEN PALM" in gesture: shield=now+.35
                    if "CLOSED FIST" in gesture: slow=now+.3
                    scale=.33 if slow>now else 1.; distance+=dt*12*scale
                    for trap in traps:
                        trap.x-=trap.speed*scale
                        if trap.x<-150: traps[traps.index(trap)]=Trap()
                        elif trap.hit(x,y,elapsed):
                            if shield<=now: health-=1
                            trap.x=-200
                    if health<=0 or elapsed>=ROUND:
                        result=(int(distance),min(elapsed,ROUND),max(0,health),0); data[current]['best']=max(best_score(data.get(current)),result[0]); result=(result[0],result[1],result[2],best_score(data.get(current))); save(data); state="results"
                else: gesture=hands.read(frame)[2]
                for trap in traps: trap.draw(frame,elapsed)
                balloon(frame,x,y,shield>now,health); hud(frame,current,max(0,ROUND-elapsed),int(distance),health,gesture,camera_ok,paused)
            last=now; cv2.imshow(WIN,frame)
            key = cv2.waitKeyEx(16)
            if key != -1:
                keypress(key & 0xFF)
    finally:
        hands.close(); camera.release(); cv2.destroyAllWindows()


if __name__=="__main__":
    try:
        main()
    except Exception as error:
        crash_log(error)
        raise
