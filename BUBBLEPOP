def open_camera():
    for backend in (cv2.CAP_DSHOW, cv2.CAP_ANY):
        try:
            camera = cv2.VideoCapture(0, backend)
            if camera.isOpened():
                camera.set(cv2.CAP_PROP_FRAME_WIDTH, 1280)
                camera.set(cv2.CAP_PROP_FRAME_HEIGHT, 720)
                camera.set(cv2.CAP_PROP_BUFFERSIZE, 1)
                return camera
            camera.release()
        except cv2.error:
            pass
    return cv2.VideoCapture()


def camera_frame(camera, tick):
    try:
        ok, image = camera.read()
    except cv2.error:
        ok, image = False, None
    if ok and image is not None:
        image = cv2.flip(image, 1)
        height, width = image.shape[:2]
        scale = max(W / width, H / height)
        resized = cv2.resize(image, (int(width * scale), int(height * scale)))
        crop_x = (resized.shape[1] - W) // 2
        crop_y = (resized.shape[0] - H) // 2
        return resized[crop_y:crop_y + H, crop_x:crop_x + W], True
    image = np.zeros((H, W, 3), dtype=np.uint8)
    image[:] = (22, 31, 39)
    txt(image, "CAMERA DISCONNECTED - RECONNECTING", (280, 365), .8, CORAL, 2)
    return image, False


class Hand:
    def __init__(self):
        self.active = False
        self.mode = None
        self.engine: Any = None
        if hands_module is not None:
            try:
                solutions = getattr(mp, "solutions", None) if mp is not None else None
                api = hands_module or getattr(solutions, "hands", None)
                if api is None:
                    raise AttributeError("MediaPipe hands API is unavailable")
                self.engine = api.Hands(max_num_hands=1, min_detection_confidence=.6, min_tracking_confidence=.55)
                self.mode = "legacy"
                self.active = True
            except (AttributeError, RuntimeError, TypeError, ValueError):
                self.engine = None
        if not self.active and all((mp, BaseOptions, VisionTaskRunningMode, HandLandmarker, HandLandmarkerOptions)):
            model = ensure_hand_model()
            if model:
                try:
                    options = HandLandmarkerOptions(
                        base_options=BaseOptions(model_asset_path=str(model)),
                        running_mode=VisionTaskRunningMode.IMAGE,
                        num_hands=1,
                        min_hand_detection_confidence=.6,
                        min_hand_presence_confidence=.6,
                        min_tracking_confidence=.55,
                    )
                    self.engine = HandLandmarker.create_from_options(options)
                    self.mode = "tasks"
                    self.active = True
                except (AttributeError, RuntimeError, TypeError, ValueError):
                    self.engine = None

    def read(self, frame):
        if not self.active or self.engine is None: return .5, .5, "MOUSE FALLBACK"
        try:
            rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            if self.mode == "tasks":
                result = self.engine.detect(mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb))
                landmarks = result.hand_landmarks
            else:
                result = self.engine.process(rgb)
                landmarks = result.multi_hand_landmarks
        except (AttributeError, RuntimeError, ValueError):
            self.active = False
            return .5, .5, "MOUSE FALLBACK"
        if not landmarks: return .5, .5, "SEARCHING FOR HAND"
        hand = landmarks[0]
        extended = sum(hand[i].y < hand[i-2].y for i in (8, 12, 16, 20))
        gesture = "OPEN PALM / SHIELD" if extended >= 4 else "CLOSED FIST / SLOW" if extended == 0 else "HAND TRACKING ACTIVE"
        return hand[9].x, hand[9].y, gesture

    def close(self):
        if self.engine:
            self.engine.close()


class Trap:
    def __init__(self):
        self.kind = random.choice(("SPIKE", "MOVING", "WALL", "ROTATOR", "FALLING"))
        self.x = W + random.randint(0, 300); self.y = random.randint(145, 570)
        self.w = random.randint(42, 72); self.h = random.randint(45, 100)
        self.speed = random.uniform(5.5, 9); self.phase = random.random() * 6

    def position(self, elapsed):
        y = self.y + math.sin(elapsed*3 + self.phase)*85 if self.kind == "MOVING" else self.y
        return int(self.x), int(y), self.w, self.h

    def hit(self, bx, by, elapsed):
        x, y, w, h = self.position(elapsed)
        return abs(bx-(x+w/2)) < w/2+34 and abs(by-(y+h/2)) < h/2+43

    def draw(self, frame, elapsed):
        x, y, w, h = self.position(elapsed)
        colors = {"SPIKE": CORAL, "MOVING": PINK, "WALL": (90,175,240), "ROTATOR": YELLOW, "FALLING": (130,220,135)}
        color = colors[self.kind]
        glow = frame.copy()
        center = (x + w // 2, y + h // 2)
        cv2.circle(glow, center, max(w, h) // 2 + 12, color, 2, cv2.LINE_AA)
        cv2.addWeighted(glow, .18, frame, .82, 0, frame)
        if self.kind == "SPIKE":
            points = np.array([[x,y+h],[x+w//2,y],[x+w,y+h]], np.int32)
            inner = np.array([[x+8,y+h-8],[x+w//2,y+18],[x+w-8,y+h-8]], np.int32)
            cv2.fillPoly(frame,[points],color)
            cv2.fillPoly(frame,[inner],(145, 145, 255))
            cv2.polylines(frame,[points],True,WHITE,2,cv2.LINE_AA)
            cv2.line(frame,(x+w//2,y+22),(x+w//2-8,y+h-20),WHITE,2,cv2.LINE_AA)
        elif self.kind == "ROTATOR":
            c=(x+w//2,y+h//2)
            cv2.ellipse(frame,c,(w//2,h//2),elapsed*90,0,360,(55,65,90),10,cv2.LINE_AA)
            cv2.ellipse(frame,c,(w//2,h//2),elapsed*90,0,300,color,6,cv2.LINE_AA)
            for angle in (elapsed*90, elapsed*90+120, elapsed*90+240):
                radians = math.radians(angle)
                endpoint = (int(c[0]+math.cos(radians)*w*.36), int(c[1]+math.sin(radians)*h*.36))
                cv2.line(frame,c,endpoint,WHITE,2,cv2.LINE_AA)
            cv2.circle(frame,c,5,WHITE,-1,cv2.LINE_AA)
        elif self.kind == "FALLING":
            radius = min(w,h)//2
            cv2.line(frame,(center[0],y-34),(center[0],y-8),color,5,cv2.LINE_AA)
            cv2.line(frame,(center[0]-5,y-30),(center[0]-5,y-10),WHITE,1,cv2.LINE_AA)
            cv2.circle(frame,center,radius,color,-1,cv2.LINE_AA)
            cv2.circle(frame,center,radius,WHITE,2,cv2.LINE_AA)
            cv2.ellipse(frame,(center[0]-radius//3,center[1]-radius//3),(max(2,radius//5),max(2,radius//3)),-25,0,360,(220,245,255),-1,cv2.LINE_AA)
        else:
            cv2.rectangle(frame,(x,y),(x+w,y+h),(48,55,78),-1,cv2.LINE_AA)
            cv2.rectangle(frame,(x+4,y+4),(x+w-4,y+h-4),color,-1,cv2.LINE_AA)
            cv2.rectangle(frame,(x,y),(x+w,y+h),WHITE,2,cv2.LINE_AA)
            for stripe_y in range(y+16,y+h-8,20):
                cv2.line(frame,(x+8,stripe_y),(x+w-8,stripe_y),WHITE,1,cv2.LINE_AA)
            cv2.line(frame,(x+7,y+7),(x+w-8,y+7),(220,245,255),2,cv2.LINE_AA)


